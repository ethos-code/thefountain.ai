---
import '../styles/global.css';
import Header from '../components/Header.astro';
import PenStage from '../components/PenStage.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fountain — Ambient AI hardware concept',
  description = 'Fountain is a concept for ambient AI hardware — a wearable Pin and a desktop Stand that project intelligence into the physical world, instead of behind a screen. By John McGinn.',
} = Astro.props;

const SITE_URL = 'https://thefountain.ai';
const OG_IMAGE = `${SITE_URL}/assets/og.jpg`;
const OG_DESCRIPTION = 'A wearable Pin and a desktop Stand that project intelligence into the physical world, instead of behind a screen.';
const TWITTER_DESCRIPTION = 'A wearable Pin and a desktop Stand that project intelligence into the physical world.';
const OG_IMAGE_ALT = 'Fountain — Ambient AI hardware concept by John McGinn';

const base = import.meta.env.BASE_URL;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Fountain',
  url: SITE_URL,
  description: 'A concept for ambient AI hardware. By John McGinn.',
  inLanguage: 'en-US',
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fountain',
  url: SITE_URL,
  description: 'A concept for ambient AI hardware — a wearable Pin and a desktop Stand that project intelligence into the physical world.',
  founder: {
    '@type': 'Person',
    name: 'John McGinn',
    url: 'https://mcginn.co',
    sameAs: [
      'https://linkedin.com/in/johnsmcginn',
      'https://behance.net/mcginnco',
    ],
  },
  sameAs: ['https://mcginn.co'],
  knowsAbout: [
    'Ambient AI',
    'AI hardware',
    'On-device AI',
    'Spatial computing',
    'Agentic AI',
    'Wearable computing',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Fountain AI, Fountain AI hardware, ambient AI, AI hardware concept, AI pin, wearable AI, AI pendant, AI device, post-screen computing, ambient computing, on-device AI, spatial AI, agentic AI hardware, John McGinn Fountain" />
    <meta name="author" content="John McGinn" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#0A0908" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={SITE_URL} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:site_name" content="Fountain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={OG_DESCRIPTION} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={TWITTER_DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:creator" content="@johnsmcginn" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>

    <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/$/, '')}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Spline web component runtime — used by <spline-viewer> in PenStage. -->
    <script
      type="module"
      src="https://unpkg.com/@splinetool/viewer@1.12.92/build/spline-viewer.js"
    ></script>
  </head>
  <body>
    <div class="page-grid" aria-hidden="true">
      <div class="page-grid-inner">
        <span class="g-line"></span>
        <span class="g-line"></span>
        <span class="g-line"></span>
      </div>
    </div>
    <Header />
    <PenStage />
    <slot />
    <script is:inline>
      requestAnimationFrame(() => {
        document.body.setAttribute('data-grid-ready', 'true');
      });
    </script>
    <script>
      import { initSmoothScroll } from '../lib/scroll';
      initSmoothScroll();
    </script>
  </body>
</html>
