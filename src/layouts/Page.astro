---
import '../styles/global.css';
import Header from '../components/Header.astro';
import PenStage from '../components/PenStage.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fountain',
  description = 'Fountain is an ambient AI device system. The screen looks back at you. Fountain looks with you.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const ogImage = `${base.replace(/\/$/, '')}/og.jpg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0908" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={`${base.replace(/\/$/, '')}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-grid" aria-hidden="true">
      <div class="page-grid-inner">
        <span class="g-line"></span>
        <span class="g-line"></span>
        <span class="g-line"></span>
      </div>
    </div>
    <Header />
    <PenStage />
    <slot />
    <script is:inline>
      requestAnimationFrame(() => {
        document.body.setAttribute('data-grid-ready', 'true');
      });
    </script>
  </body>
</html>
