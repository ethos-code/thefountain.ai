---
import { sections } from '../lib/sections';
---

<header class="header">
  <div class="header-frame">
    <div class="header-frame-inner">
      <button
        type="button"
        class="brand"
        data-menu-trigger
        aria-label="Open navigation menu"
        aria-controls="menu-sheet"
        aria-expanded="false"
      >
        FOUNTAIN<sup aria-hidden="true">&reg;</sup>
      </button>
    </div>
  </div>

  <div class="menu-sheet" id="menu-sheet" data-menu-sheet hidden>
    <button type="button" class="menu-close" data-menu-close aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <line x1="4" y1="4" x2="20" y2="20" />
        <line x1="20" y1="4" x2="4" y2="20" />
      </svg>
    </button>
    <div class="menu-inner">
      <ul>
        {sections.filter((s) => s.id !== 'hero').map((s, i) => (
          <li>
            <a href={`#${s.id}`} data-target={s.id}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="lbl">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const trigger = document.querySelector('[data-menu-trigger]');
    const sheet = document.querySelector('[data-menu-sheet]');
    const closeBtn = document.querySelector('[data-menu-close]');
    if (!trigger || !sheet) return;

    const open = () => {
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.setAttribute('data-open', 'true'));
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      sheet.removeAttribute('data-open');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => { sheet.hidden = true; }, 280);
    };

    trigger.addEventListener('click', () => {
      if (sheet.hasAttribute('data-open')) close();
      else open();
    });
    closeBtn?.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet.hasAttribute('data-open')) close();
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('a[data-target]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('data-target');
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        const lenis = window.lenis;
        if (lenis && !reduceMotion) {
          lenis.scrollTo(el, { duration: 1.6 });
        } else {
          el.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        }
        history.replaceState(null, '', `#${id}`);
        if (sheet.hasAttribute('data-open')) setTimeout(close, 220);
      });
    });
  })();
</script>

<style>
  .header {
    pointer-events: none;
  }

  .header-frame {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 0;
    z-index: 110;
    pointer-events: none;
    display: flex;
    justify-content: center;
  }
  .header-frame-inner {
    position: relative;
    width: 100%;
    max-width: var(--frame-max);
    height: 0;
  }

  .brand {
    pointer-events: auto;
    position: absolute;
    top: clamp(24px, 4vh, 44px);
    left: 25%;            /* aligns with col-2 grid line */
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    color: #FFFFFF;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(18px, 2.5vw, 32px);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 0.98;
    cursor: pointer;
    mix-blend-mode: difference;
    transition: opacity 200ms ease;
  }
  .brand sup {
    font-size: 0.62em;
    font-weight: 500;
    letter-spacing: 0;
    margin-left: 0.08em;
    vertical-align: super;
    text-transform: none;
    top: 0;
  }
  .brand:focus-visible {
    outline: 1px dashed currentColor;
    outline-offset: 8px;
  }
  @media (max-width: 900px) {
    .brand {
      left: clamp(20px, 6vw, 32px);
    }
  }

  .menu-sheet {
    position: fixed;
    inset: 0;
    background: rgb(10 9 8 / 0.96);
    backdrop-filter: blur(24px) saturate(1.1);
    -webkit-backdrop-filter: blur(24px) saturate(1.1);
    z-index: 105;
    opacity: 0;
    transition: opacity 280ms var(--ease-out-refined);
    pointer-events: auto;
    overflow-y: auto;
  }
  .menu-sheet[data-open="true"] {
    opacity: 1;
  }
  .menu-sheet::before {
    content: '';
    position: fixed;
    top: 0;
    bottom: 0;
    width: 1px;
    left: max(25%, calc(50% - var(--frame-max) / 4));
    background: var(--color-hairline);
    pointer-events: none;
    z-index: 106;
  }

  .menu-inner {
    max-width: none;
    margin: 0;
    padding: clamp(120px, 18vh, 200px) 0 clamp(48px, 8vh, 96px);
  }
  .menu-inner ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-inner li {
    border-top: 1px solid var(--color-hairline);
  }
  .menu-inner li:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }
  .menu-inner a {
    max-width: var(--frame-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 25% 1fr;
    align-items: baseline;
    padding: clamp(20px, 3vh, 32px) 0;
    color: var(--color-ink);
    text-decoration: none;
    transition: padding-left 280ms var(--ease-out-refined);
  }
  .menu-inner a:hover,
  .menu-inner a:focus-visible {
    padding-left: 12px;
    outline: none;
  }
  .menu-inner .idx {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--color-meta);
    text-align: right;
    padding-right: clamp(20px, 3vw, 36px);
  }
  .menu-inner .lbl {
    font-family: var(--font-display);
    font-size: clamp(28px, 4.4vw, 56px);
    font-weight: 600;
    letter-spacing: -0.034em;
    line-height: 1.05;
  }
  @media (max-width: 900px) {
    .menu-sheet::before {
      left: clamp(20px, 6vw, 32px);
    }
    .menu-inner a {
      grid-template-columns: clamp(28px, 8vw, 40px) 1fr;
      padding-left: clamp(20px, 6vw, 32px);
      padding-right: clamp(20px, 6vw, 32px);
    }
    .menu-inner .idx {
      text-align: left;
      padding-right: 0;
    }
  }

  .menu-close {
    position: fixed;
    top: clamp(24px, 4vh, 44px);
    right: clamp(24px, 6vw, 96px);
    z-index: 111;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
    padding: 0;
    width: clamp(36px, 3.4vw, 44px);
    height: clamp(36px, 3.4vw, 44px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .menu-close svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1;
    fill: none;
    stroke-linecap: square;
  }
</style>
