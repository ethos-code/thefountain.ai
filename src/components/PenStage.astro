---
const SPLINE_URL = 'https://my.spline.design/fountainclean-sBz7vvQkxCKWDeB5BG1KqRUQ/';

/* Note on transparency:
   Spline iframes serve a complete viewer page with the scene data inlined
   (the splinecode is bundled into the HTML, not exposed as a separate URL).
   That means the iframe's background is whatever the scene was published
   with — CSS `background: transparent` on the iframe element doesn't strip
   pixels rendered inside it.

   Two ways to get a transparent background:

   1. Re-publish the scene from Spline editor with ALL of these set:
      - Scene → Background → set color alpha to 0 (transparent)
      - No solid background plane/cube object in the scene
      - HDRI environment: keep for lighting, but disable its "Background"
        visibility so the skybox doesn't render
      - Camera: no override background

   2. Or switch to <spline-viewer> web component (preferred):
      - In Spline: File → Export → Code Export → Web Component
      - Copy the .splinecode URL it generates
      - Share that URL — we'll swap iframe for <spline-viewer> which
        renders to a transparent <canvas>
*/
---

<div class="pen-stage" data-pen-stage>
  <iframe
    src={SPLINE_URL}
    title="Fountain — interactive 3D pen"
    allow="autoplay; fullscreen; xr-spatial-tracking"
    loading="eager"
    aria-hidden="true"
    style="background: transparent;"
  ></iframe>
</div>

<script is:inline>
  (() => {
    const stage = document.querySelector('[data-pen-stage]');
    if (!stage) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    let ticking = false;

    const update = () => {
      const scrollY = window.scrollY;
      const heroEnd = window.innerHeight;
      const t = Math.max(0, Math.min(1, scrollY / heroEnd));
      const eased = 1 - Math.pow(1 - t, 2.2);

      const width = 100 - 75 * eased;
      const height = 100 - 30 * eased;
      const top = (100 - height) / 2;

      stage.style.setProperty('--w', `${width}vw`);
      stage.style.setProperty('--h', `${height}vh`);
      stage.style.setProperty('--top', `${top}vh`);

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => requestAnimationFrame(update));

    const status = document.querySelector('[data-section="status"]');
    if (status && 'IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const fading = entry.isIntersecting && entry.intersectionRatio > 0.35;
            stage.setAttribute('data-fade', fading ? 'true' : 'false');
          });
        },
        { threshold: [0, 0.2, 0.35, 0.5, 0.7] }
      );
      obs.observe(status);
    }
  })();
</script>

<style>
  .pen-stage {
    position: fixed;
    top: var(--top, 0);
    right: 0;
    width: var(--w, 100vw);
    height: var(--h, 100vh);
    pointer-events: none;
    z-index: 4;
    transition: opacity 800ms var(--ease-out-refined);
  }
  .pen-stage[data-fade="true"] {
    opacity: 0;
  }
  .pen-stage iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    pointer-events: none;
    display: block;
  }

  @media (max-width: 900px) {
    .pen-stage { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pen-stage {
      width: 100vw;
      height: 100vh;
      top: 0;
    }
  }
</style>
