---
/* Spline web component renders the .splinecode file directly to a
   transparent <canvas>, sidestepping the iframe's baked-in background.
   Runtime script is loaded once in src/layouts/Page.astro head. */

const SPLINECODE_URL = 'https://prod.spline.design/ACP80S192fjY66ON/scene.splinecode';
---

<div class="pen-stage" data-pen-stage>
  <spline-viewer
    url={SPLINECODE_URL}
    loading-anim-type="none"
    aria-hidden="true"
  ></spline-viewer>
  <button
    type="button"
    class="pen-tap"
    data-pen-tap
    aria-label="Open Fountain in 3D"
    aria-haspopup="dialog"
  ></button>
</div>

<div
  class="pen-modal"
  data-pen-modal
  data-spline-url={SPLINECODE_URL}
  role="dialog"
  aria-modal="true"
  aria-label="Fountain 3D view"
  hidden
>
  <button
    type="button"
    class="pen-modal-close"
    data-pen-modal-close
    aria-label="Close 3D view"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <line x1="20" y1="12" x2="5" y2="12" />
      <polyline points="12 5, 5 12, 12 19" />
    </svg>
  </button>
  <div class="pen-modal-viewer" data-pen-modal-viewer></div>
</div>

<script is:inline>
  (() => {
    const stage = document.querySelector('[data-pen-stage]');
    if (!stage) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 900px)').matches;
    if (reduceMotion || isMobile) return;

    let ticking = false;

    const update = () => {
      const scrollY = window.scrollY;
      const heroEnd = window.innerHeight;
      const t = Math.max(0, Math.min(1, scrollY / heroEnd));
      const eased = 1 - Math.pow(1 - t, 2.2);

      const width = 100 - 75 * eased;
      const height = 100 - 30 * eased;
      const top = (100 - height) / 2;

      stage.style.setProperty('--w', `${width}vw`);
      stage.style.setProperty('--h', `${height}vh`);
      stage.style.setProperty('--top', `${top}vh`);

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => requestAnimationFrame(update));

    const status = document.querySelector('[data-section="status"]');
    if (status && 'IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const fading = entry.isIntersecting && entry.intersectionRatio > 0.35;
            stage.setAttribute('data-fade', fading ? 'true' : 'false');
          });
        },
        { threshold: [0, 0.2, 0.35, 0.5, 0.7] }
      );
      obs.observe(status);
    }
  })();
</script>

<script is:inline>
  (() => {
    const tap = document.querySelector('[data-pen-tap]');
    const modal = document.querySelector('[data-pen-modal]');
    const closeBtn = document.querySelector('[data-pen-modal-close]');
    const host = document.querySelector('[data-pen-modal-viewer]');
    if (!tap || !modal || !closeBtn || !host) return;

    let viewerLoaded = false;
    let lastFocus = null;

    const open = () => {
      if (!viewerLoaded) {
        const url = modal.getAttribute('data-spline-url') || '';
        const vw = document.createElement('spline-viewer');
        vw.setAttribute('url', url);
        vw.setAttribute('loading-anim-type', 'none');
        host.appendChild(vw);
        viewerLoaded = true;
      }
      lastFocus = document.activeElement;
      modal.hidden = false;
      requestAnimationFrame(() => modal.setAttribute('data-open', 'true'));
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const close = () => {
      modal.removeAttribute('data-open');
      document.body.style.overflow = '';
      setTimeout(() => {
        modal.hidden = true;
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      }, 280);
    };

    tap.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.hasAttribute('data-open')) close();
    });
  })();
</script>

<style>
  .pen-stage {
    position: fixed;
    top: var(--top, 0);
    right: 0;
    width: var(--w, 100vw);
    height: var(--h, 100vh);
    pointer-events: none;
    z-index: 150;
    transition: opacity 800ms var(--ease-out-refined);
  }
  .pen-stage[data-fade="true"] {
    opacity: 0;
  }
  .pen-stage spline-viewer {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    pointer-events: none;
  }
  .pen-stage spline-viewer::part(logo) {
    display: none;
  }

  .pen-tap {
    position: absolute;
    inset: 0;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    pointer-events: auto;
  }
  .pen-stage[data-fade="true"] .pen-tap {
    pointer-events: none;
  }
  .pen-tap:focus-visible {
    outline: 1px dashed var(--color-ink);
    outline-offset: -8px;
  }

  .pen-modal {
    position: fixed;
    inset: 0;
    background: rgb(10 9 8 / 0.96);
    backdrop-filter: blur(24px) saturate(1.1);
    -webkit-backdrop-filter: blur(24px) saturate(1.1);
    z-index: 200;
    opacity: 0;
    transition: opacity 280ms var(--ease-out-refined);
  }
  .pen-modal[data-open="true"] {
    opacity: 1;
  }
  .pen-modal-viewer {
    position: absolute;
    inset: 0;
  }
  .pen-modal-viewer spline-viewer {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
  }
  .pen-modal-viewer spline-viewer::part(logo) {
    display: none;
  }

  .pen-modal-close {
    position: fixed;
    top: clamp(24px, 4vh, 44px);
    left: clamp(20px, 6vw, 32px);
    z-index: 201;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
    padding: 0;
    width: clamp(36px, 3.4vw, 44px);
    height: clamp(36px, 3.4vw, 44px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pen-modal-close svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1;
    fill: none;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  @media (max-width: 900px) {
    .pen-stage {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pen-stage {
      width: 100vw;
      height: 100vh;
      top: 0;
    }
  }
</style>
