---
import { sections } from '../lib/sections';
---

<nav class="section-nav" aria-label="Section navigation" data-nav>
  <!-- Desktop: vertical pills -->
  <ul class="nav-pills" data-nav-pills>
    {sections.map((s, i) => (
      <li>
        <a
          href={`#${s.id}`}
          data-target={s.id}
          aria-label={`Go to section: ${s.label}`}
          data-index={String(i + 1).padStart(2, '0')}
        >
          <span class="pill"></span>
          <span class="pill-label">{s.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <!-- Mobile: floating menu button + sheet -->
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle>
    <span class="nav-toggle-label" data-nav-current>Fountain</span>
    <span class="nav-toggle-index" data-nav-index>01 / {sections.length}</span>
  </button>

  <div class="nav-sheet" id="nav-sheet" data-nav-sheet hidden>
    <ul>
      {sections.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-target={s.id} data-sheet-link>
            <span class="sheet-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="sheet-label">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script is:inline>
  (() => {
    const nav = document.querySelector('[data-nav]');
    if (!nav) return;

    const pillLinks = nav.querySelectorAll('[data-nav-pills] a');
    const toggle = nav.querySelector('[data-nav-toggle]');
    const sheet = nav.querySelector('[data-nav-sheet]');
    const currentLabel = nav.querySelector('[data-nav-current]');
    const currentIndex = nav.querySelector('[data-nav-index]');
    const sheetLinks = nav.querySelectorAll('[data-sheet-link]');

    const sectionEls = Array.from(document.querySelectorAll('[data-section]'));
    const total = sectionEls.length;

    const labelOf = (el) => el?.getAttribute('data-section-label') || '';

    const setActive = (id) => {
      pillLinks.forEach((a) => {
        const target = a.getAttribute('data-target');
        if (target === id) a.setAttribute('data-active', 'true');
        else a.removeAttribute('data-active');
      });
      const el = sectionEls.find((s) => s.getAttribute('data-section') === id);
      if (el && currentLabel) currentLabel.textContent = labelOf(el);
      if (el && currentIndex) {
        const i = sectionEls.indexOf(el) + 1;
        currentIndex.textContent = `${String(i).padStart(2, '0')} / ${total}`;
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setActive(visible.target.getAttribute('data-section'));
        },
        { threshold: [0.4, 0.6, 0.8], rootMargin: '0px' }
      );
      sectionEls.forEach((el) => observer.observe(el));
    }

    const openSheet = () => {
      if (!sheet || !toggle) return;
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.setAttribute('data-open', 'true'));
      toggle.setAttribute('aria-expanded', 'true');
    };
    const closeSheet = () => {
      if (!sheet || !toggle) return;
      sheet.removeAttribute('data-open');
      toggle.setAttribute('aria-expanded', 'false');
      setTimeout(() => { sheet.hidden = true; }, 240);
    };

    toggle?.addEventListener('click', () => {
      if (sheet?.hasAttribute('data-open')) closeSheet();
      else openSheet();
    });

    document.addEventListener('click', (e) => {
      if (!sheet?.hasAttribute('data-open')) return;
      const target = e.target;
      if (target instanceof Node && !nav.contains(target)) closeSheet();
    });

    sheetLinks.forEach((a) => a.addEventListener('click', () => setTimeout(closeSheet, 50)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet?.hasAttribute('data-open')) closeSheet();
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    nav.querySelectorAll('a[data-target]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('data-target');
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
      });
    });
  })();
</script>

<style>
  .section-nav {
    position: fixed;
    z-index: 50;
    color: var(--color-ink);
    pointer-events: none;
  }
  .section-nav > * { pointer-events: auto; }

  /* Desktop pills */
  .nav-pills {
    position: fixed;
    right: clamp(16px, 2vw, 32px);
    top: 50%;
    transform: translateY(-50%);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .nav-pills li { display: block; }
  .nav-pills a {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    text-decoration: none;
    padding: 4px 0;
    cursor: pointer;
  }
  .nav-pills .pill {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in oklab, var(--color-ink) 28%, transparent);
    transition: background 280ms var(--ease-out-refined),
                width 280ms var(--ease-out-refined);
  }
  .nav-pills a:hover .pill,
  .nav-pills a:focus-visible .pill {
    background: color-mix(in oklab, var(--color-ink) 70%, transparent);
  }
  .nav-pills a[data-active="true"] .pill {
    background: var(--color-ink);
    width: 32px;
  }
  .nav-pills .pill-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-meta);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 200ms ease, transform 280ms var(--ease-out-refined);
    white-space: nowrap;
  }
  .nav-pills a:hover .pill-label,
  .nav-pills a:focus-visible .pill-label,
  .nav-pills a[data-active="true"] .pill-label {
    opacity: 1;
    transform: translateX(0);
  }

  /* Mobile toggle (hidden on desktop) */
  .nav-toggle {
    display: none;
    position: fixed;
    right: clamp(16px, 4vw, 24px);
    bottom: clamp(16px, 4vw, 24px);
    background: rgba(20, 18, 16, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-hairline-strong);
    border-radius: 999px;
    color: var(--color-ink);
    font: inherit;
    padding: 10px 16px;
    cursor: pointer;
    align-items: center;
    gap: 12px;
  }
  .nav-toggle-label {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 500;
  }
  .nav-toggle-index {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--color-meta);
  }

  .nav-sheet {
    position: fixed;
    inset: 0;
    background: rgba(10, 9, 8, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 60;
    opacity: 0;
    transition: opacity 240ms ease;
    overflow-y: auto;
    padding: clamp(48px, 12vh, 96px) clamp(24px, 6vw, 48px);
  }
  .nav-sheet[data-open="true"] { opacity: 1; }
  .nav-sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .nav-sheet li { border-top: 1px solid var(--color-hairline); }
  .nav-sheet li:last-child { border-bottom: 1px solid var(--color-hairline); }
  .nav-sheet a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  .nav-sheet .sheet-index {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--color-meta);
    min-width: 24px;
  }
  .nav-sheet .sheet-label {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (max-width: 1023px) {
    .nav-pills { display: none; }
    .nav-toggle { display: inline-flex; }
  }
</style>
