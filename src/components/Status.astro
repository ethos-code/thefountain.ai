---
import SignupForm from './SignupForm.astro';
---

<div class="status frame">
  <div class="block col-2-3">
    <header class="reveal">
      <p class="eyebrow">Where we are.</p>
      <h2>In research,<br>and listening.</h2>
    </header>
    <p class="reveal copy">
      Fountain is in research and prototyping. We're not selling anything.
      We're building a thesis about what AI hardware should feel like, and
      learning what it would take to bring it into the world.
    </p>
    <p class="reveal copy closer">
      If that interests you, leave an email. We'll be in touch when there's
      something to show.
    </p>
    <div class="form-wrap reveal">
      <SignupForm />
    </div>
  </div>

  <div class="status-footer block col-2-3">
    <span>© Copyright 2026 Low Key Capital, LLC</span>
    <span class="dot" aria-hidden="true">•</span>
    <span>A concept by <a href="mailto:j@mcginn.co">j@mcginn.co</a></span>
    <span class="dot" aria-hidden="true">•</span>
    <span><a href="https://mcginn.co" rel="noopener">mcginn.co</a></span>
  </div>
</div>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-meta);
    margin: 0 0 24px;
  }
  header h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.038em;
    line-height: 0.98;
    margin: 0 0 1em;
    color: var(--color-ink);
  }
  .copy {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--color-ink-muted);
    margin: 0 0 1.4em;
    max-width: 56ch;
  }
  .closer {
    margin-bottom: 2.4em;
  }

  .status-footer {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-meta);
    padding-top: clamp(32px, 5vh, 56px);
    margin-top: clamp(48px, 8vh, 96px);
    border-top: 1px solid var(--color-hairline);
  }
  .status-footer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease, color 200ms ease;
    padding-bottom: 1px;
  }
  .status-footer a:hover,
  .status-footer a:focus-visible {
    color: var(--color-ink);
    border-bottom-color: var(--color-meta);
    outline: none;
  }
  .status-footer .dot { opacity: 0.5; }

  [data-revealed="true"] header { transition-delay: 0ms; }
  [data-revealed="true"] .copy:nth-of-type(1) { transition-delay: 160ms; }
  [data-revealed="true"] .copy:nth-of-type(2) { transition-delay: 320ms; }
  [data-revealed="true"] .form-wrap { transition-delay: 480ms; }
</style>
