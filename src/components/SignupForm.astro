---
---

<form
  class="signup"
  id="signup"
  action="https://script.google.com/macros/s/AKfycbwDbSwCpoCIX-g_8znys58h1BksCpVCUfTn6EUCN-AsCvnKZAmmHmWZcxFm5kDX6L1d/exec"
  method="POST"
  novalidate
>
  <label for="signup-email" class="visually-hidden">Email address</label>
  <input
    id="signup-email"
    type="email"
    name="email"
    autocomplete="email"
    placeholder="email"
    required
  />
  <button type="submit" class="signup-submit">Stay close</button>
</form>
<div class="signup-msg" aria-live="polite" id="signup-msg"></div>

<script is:inline>
  (() => {
    const form = document.getElementById('signup');
    if (!form) return;
    const msg = document.getElementById('signup-msg');
    const input = form.querySelector('input[type="email"]');
    const button = form.querySelector('button[type="submit"]');

    const setMsg = (text, state) => {
      if (!msg) return;
      msg.textContent = text;
      if (state) msg.setAttribute('data-state', state);
      else msg.removeAttribute('data-state');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (input.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setMsg('Enter a valid email.', 'error');
        input.focus();
        return;
      }

      const action = form.getAttribute('action') || '';
      button.disabled = true;
      setMsg('Sending…');
      try {
        const body = new URLSearchParams({ email, source: 'thefountain.ai' });
        await fetch(action, { method: 'POST', mode: 'no-cors', body });
        form.style.display = 'none';
        setMsg("You’re in 🤍", 'success');
      } catch {
        setMsg('Network error. Try again?', 'error');
        button.disabled = false;
      }
    });
  })();
</script>

<style>
  .signup {
    display: flex;
    align-items: center;
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 25%, transparent);
    transition: border-color 220ms ease;
    width: min(420px, 100%);
  }
  .signup:focus-within {
    border-bottom-color: var(--color-ink);
  }
  .signup input[type="email"] {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    font: inherit;
    font-family: var(--font-body);
    font-size: 16px;
    letter-spacing: -0.005em;
    padding: 12px 0;
    outline: none;
  }
  .signup input[type="email"]::placeholder {
    color: color-mix(in oklab, var(--color-ink) 38%, transparent);
  }
  .signup input[type="email"]:-webkit-autofill {
    -webkit-text-fill-color: var(--color-ink);
    box-shadow: 0 0 0 30px var(--color-paper) inset;
    transition: background-color 9999s ease-out;
  }
  .signup-submit {
    background: transparent;
    border: 0;
    color: var(--color-ink);
    font: inherit;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    padding: 12px 0 12px 16px;
    cursor: pointer;
    line-height: 1;
    opacity: 0.7;
    transition: opacity 200ms ease, transform 240ms var(--ease-out-refined);
    white-space: nowrap;
  }
  .signup-submit:hover,
  .signup-submit:focus-visible {
    opacity: 1;
    transform: translateX(2px);
    outline: none;
  }
  .signup-submit[disabled] {
    opacity: 0.3;
    cursor: default;
  }
  .signup-msg {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-meta);
    line-height: 1.4;
    min-height: 14px;
    margin-top: 12px;
  }
  .signup-msg[data-state="success"] {
    color: var(--color-ink);
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-body);
    font-size: 15px;
  }
  .signup-msg[data-state="error"] {
    color: var(--color-error);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
