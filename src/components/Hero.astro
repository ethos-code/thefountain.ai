---
interface Props {
  iframeUrl?: string;
}
const { iframeUrl } = Astro.props;
---

<div class="hero">
  <div class="hero-meta">
    <div class="wordmark">Fountain</div>
    <div class="status-mark">Concept · 2026</div>
  </div>
  <div class="hero-stage">
    {iframeUrl ? (
      <iframe
        src={iframeUrl}
        title="Fountain — interactive 3D turntable"
        allow="autoplay; fullscreen; xr-spatial-tracking"
        loading="eager"
      ></iframe>
    ) : (
      <div class="hero-placeholder" role="img" aria-label="Hero turntable iframe goes here">
        <span>Hero turntable iframe goes here</span>
      </div>
    )}
  </div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: var(--color-paper);
    overflow: hidden;
  }
  .hero-meta {
    position: absolute;
    top: clamp(20px, 4vh, 36px);
    left: clamp(24px, 6vw, 96px);
    right: clamp(24px, 6vw, 96px);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 2;
    pointer-events: none;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.005em;
    line-height: 1;
    text-transform: uppercase;
  }
  .status-mark {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-meta);
    text-align: right;
    line-height: 1;
  }
  .hero-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-stage iframe,
  .hero-placeholder {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: transparent;
  }
  /* Spline iframes capture wheel events for camera zoom, which traps page
     scroll. Disable pointer events so wheel/scroll passes through. The
     scene's own auto-rotation/animation still plays — visitors lose drag
     orbit but get clean page scrolling. To restore interactivity, switch
     to a click-to-engage overlay pattern. */
  .hero-stage iframe {
    pointer-events: none;
  }
  .hero-placeholder {
    border: 1px dashed var(--color-hairline-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-meta);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
