---
/* Hero is now an empty 100vh spacer. The Spline iframe lives in
   PenStage (rendered globally in Page.astro) and morphs from
   full-bleed at scroll=0 to a fixed right-column floater as the
   user scrolls past this section. */
---

<div class="hero">
  <h1 class="hero-h1">Fountain</h1>
</div>

<style>
  .hero {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: var(--color-paper);
  }
  .hero-h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
