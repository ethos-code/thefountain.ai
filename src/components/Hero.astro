---
interface Props {
  iframeUrl?: string;
}
const { iframeUrl } = Astro.props;
---

<div class="hero">
  <div class="hero-meta">
    <div class="wordmark">Fountain</div>
    <div class="status-mark">Concept · 2026</div>
  </div>
  <div class="hero-stage">
    {iframeUrl ? (
      <iframe
        src={iframeUrl}
        title="Fountain — interactive 3D turntable"
        allow="autoplay; fullscreen; xr-spatial-tracking"
        loading="eager"
      ></iframe>
    ) : (
      <div class="hero-placeholder" role="img" aria-label="Hero turntable iframe goes here">
        <span>Hero turntable iframe goes here</span>
      </div>
    )}
  </div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-paper);
    overflow: hidden;
  }
  .hero-meta {
    position: absolute;
    top: clamp(24px, 5vh, 48px);
    left: clamp(24px, 6vw, 96px);
    right: clamp(24px, 6vw, 96px);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 2;
    pointer-events: none;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .status-mark {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-meta);
    text-align: right;
    line-height: 1;
  }
  .hero-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(96px, 14vh, 144px) clamp(32px, 6vw, 96px);
  }
  .hero-stage iframe,
  .hero-placeholder {
    width: min(80vw, 1200px);
    height: min(72vh, 720px);
    border: 0;
    display: block;
    background: transparent;
  }
  .hero-placeholder {
    border: 1px dashed var(--color-hairline-strong);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-meta);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
