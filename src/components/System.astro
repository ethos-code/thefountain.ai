---
---

<div class="system">
  <header class="system-header reveal">
    <p class="eyebrow">The system.</p>
    <h2>Two devices.<br>One experience.</h2>
  </header>

  <div class="grid">
    <article class="device reveal">
      <h3 class="device-name">Pin</h3>
      <p class="device-desc">
        Wearable. Sees and listens close to you.
        Projects within reach.
      </p>
    </article>
    <article class="device reveal">
      <h3 class="device-name">Stand</h3>
      <p class="device-desc">
        For the desk, the table, the entryway.
        Augments the surfaces you already work and live on.
      </p>
    </article>
  </div>

  <p class="closer reveal">
    They share an ambient operating layer. Wherever you are, the right one
    is with you, and what they show stays consistent.
  </p>
</div>

<style>
  .system {
    max-width: 1280px;
    margin: 0 auto;
  }
  .system-header {
    margin-bottom: clamp(64px, 10vh, 120px);
    max-width: 760px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-meta);
    margin: 0 0 24px;
  }
  .system-header h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.038em;
    line-height: 0.98;
    margin: 0;
    color: var(--color-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    margin-bottom: clamp(56px, 8vh, 96px);
    border-top: 1px solid var(--color-hairline);
    padding-top: clamp(48px, 7vh, 80px);
  }
  .device {
    margin: 0;
  }
  .device-name {
    font-family: var(--font-display);
    font-size: clamp(72px, 12vw, 168px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.92;
    margin: 0 0 28px;
    color: var(--color-ink);
  }
  .device-desc {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--color-ink-muted);
    max-width: 32ch;
    margin: 0;
  }

  .closer {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--color-ink-muted);
    max-width: 56ch;
    margin: 0;
    border-top: 1px solid var(--color-hairline);
    padding-top: clamp(32px, 5vh, 56px);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  [data-revealed="true"] .system-header { transition-delay: 0ms; }
  [data-revealed="true"] .device:nth-of-type(1) { transition-delay: 160ms; }
  [data-revealed="true"] .device:nth-of-type(2) { transition-delay: 280ms; }
  [data-revealed="true"] .closer { transition-delay: 440ms; }
</style>
