---
interface Callout { value: string; unit: string; caption: string; }

const pinCallouts: Callout[] = [
  { value: '50',  unit: 'TOPS',     caption: 'on-device neural engine' },
  { value: '16',  unit: 'GB',       caption: 'unified memory' },
  { value: '30',  unit: 'ANSI lm',  caption: 'pico-projection' },
  { value: '14',  unit: 'hr',       caption: 'active use' },
];

const standCallouts: Callout[] = [
  { value: '200', unit: 'TOPS',     caption: 'on-device neural engine' },
  { value: '32',  unit: 'GB',       caption: 'unified memory' },
  { value: '80',  unit: 'ANSI lm',  caption: 'pico-projection' },
  { value: '1',   unit: 'TB',       caption: 'on-device storage' },
];

const pinFineprint = [
  '4 MP RGB-D camera with depth sensor',
  '3-mic beamforming array · spatial audio capture',
  '≤ 4B parameter on-device foundation model',
  'Wi-Fi 7 · Bluetooth 6 · UWB precision positioning',
  '256 GB on-device storage',
  'Magnetic wireless charging',
  'Machined aluminum body · sapphire crystal lens',
  '18 g · IP54 water and dust rated',
];

const standFineprint = [
  '8 MP RGB-D camera · LiDAR scanner',
  '6-mic beamforming array · spatial audio capture and playback',
  '≤ 12B parameter on-device foundation model',
  'Wi-Fi 7 · Thread · Matter · UWB · Bluetooth 6',
  'USB-C power · wireless charging puck for the Pin',
  'Anodized aluminum body · optical-grade glass aperture',
  '14 cm tall · 4 cm diameter',
];
---

<div class="specs">
  <header class="reveal">
    <p class="eyebrow">An imagined spec.</p>
    <h2>The numbers we're<br>aiming at.</h2>
    <p class="lede">
      We're not building hardware yet. These are the targets we'd aim at —
      what the technology of the next few years could make possible.
    </p>
  </header>

  <section class="device-block reveal" aria-labelledby="pin-spec">
    <h3 id="pin-spec" class="device-spec-name">Pin</h3>
    <ul class="callouts">
      {pinCallouts.map(({ value, unit, caption }) => (
        <li>
          <span class="big" data-count={value}>{value}</span>
          <span class="unit">{unit}</span>
          <span class="caption">{caption}</span>
        </li>
      ))}
    </ul>
    <ul class="fineprint">
      {pinFineprint.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <section class="device-block reveal" aria-labelledby="stand-spec">
    <h3 id="stand-spec" class="device-spec-name">Stand</h3>
    <ul class="callouts">
      {standCallouts.map(({ value, unit, caption }) => (
        <li>
          <span class="big" data-count={value}>{value}</span>
          <span class="unit">{unit}</span>
          <span class="caption">{caption}</span>
        </li>
      ))}
    </ul>
    <ul class="fineprint">
      {standFineprint.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <p class="philosophy reveal">
    Privacy-first. All sensitive inference happens on-device. End-to-end
    encrypted sync between Pin and Stand. No data leaves the device without
    explicit consent. Local-first by design.
  </p>
</div>

<script is:inline>
  (() => {
    const counters = document.querySelectorAll('[data-count]');
    if (!counters.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const animate = (el) => {
      const target = parseInt(el.getAttribute('data-count') || '0', 10);
      if (Number.isNaN(target)) return;

      if (reduceMotion) {
        el.textContent = String(target);
        return;
      }

      el.textContent = '0';
      const duration = 1400;
      const start = performance.now();

      const tick = (now) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.floor(eased * target));
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = String(target);
      };
      requestAnimationFrame(tick);
    };

    if (!('IntersectionObserver' in window)) {
      counters.forEach(animate);
      return;
    }

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !entry.target.hasAttribute('data-counted')) {
            entry.target.setAttribute('data-counted', 'true');
            animate(entry.target);
          }
        });
      },
      { threshold: 0.55 }
    );
    counters.forEach((el) => obs.observe(el));
  })();
</script>

<style>
  .specs {
    max-width: 1280px;
    margin: 0 auto;
    font-family: var(--font-mono);
  }
  header {
    max-width: 720px;
    margin-bottom: clamp(64px, 10vh, 120px);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-meta);
    margin: 0 0 24px;
  }
  header h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.038em;
    line-height: 0.98;
    margin: 0 0 24px;
    color: var(--color-ink);
  }
  header .lede {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--color-ink-muted);
    margin: 0;
    max-width: 56ch;
  }

  .device-block {
    margin-bottom: clamp(56px, 9vh, 96px);
    padding-top: clamp(40px, 6vh, 64px);
    border-top: 1px solid var(--color-hairline);
  }
  .device-spec-name {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 clamp(40px, 6vh, 64px);
    color: var(--color-ink);
  }

  .callouts {
    list-style: none;
    margin: 0 0 clamp(40px, 6vh, 64px);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 3vw, 56px);
  }
  .callouts li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .big {
    font-family: var(--font-mono);
    font-size: clamp(48px, 7.5vw, 96px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .unit {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-meta);
    margin-top: 6px;
  }
  .caption {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.4;
    color: var(--color-ink-muted);
    letter-spacing: 0;
    text-transform: none;
    margin-top: 12px;
    max-width: 16ch;
  }

  .fineprint {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px clamp(24px, 4vw, 48px);
  }
  .fineprint li {
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.05vw, 14px);
    line-height: 1.5;
    color: var(--color-meta);
    letter-spacing: 0;
  }

  .philosophy {
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.1vw, 14px);
    line-height: 1.6;
    color: var(--color-meta);
    max-width: 70ch;
    margin: 0;
    padding-top: clamp(32px, 5vh, 56px);
    border-top: 1px solid var(--color-hairline);
    letter-spacing: 0;
  }

  @media (max-width: 900px) {
    .callouts { grid-template-columns: 1fr 1fr; }
    .fineprint { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .callouts { grid-template-columns: 1fr; gap: 32px; }
  }

  [data-revealed="true"] header { transition-delay: 0ms; }
  [data-revealed="true"] .device-block:nth-of-type(1) { transition-delay: 200ms; }
  [data-revealed="true"] .device-block:nth-of-type(2) { transition-delay: 360ms; }
  [data-revealed="true"] .philosophy { transition-delay: 540ms; }
</style>
