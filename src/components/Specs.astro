---
interface Callout {
  pen: string;
  stand: string;
  unit: string;
  caption: string;
}

const callouts: Callout[] = [
  { pen: '50',  stand: '200', unit: 'TOPS',     caption: 'on-device neural engine' },
  { pen: '16',  stand: '32',  unit: 'GB',       caption: 'unified memory' },
  { pen: '30',  stand: '80',  unit: 'ANSI lm',  caption: 'pico-projection' },
  { pen: '4',   stand: '12',  unit: 'B params', caption: 'on-device foundation model' },
];

interface SpecRow { label: string; value: string; }

const fineprint: SpecRow[] = [
  { label: 'Camera',       value: '4 – 8 MP RGB-D · LiDAR on Stand' },
  { label: 'Microphones',  value: '3 – 6 mic beamforming · spatial audio' },
  { label: 'Storage',      value: '256 GB – 1 TB on-device' },
  { label: 'Connectivity', value: 'Wi-Fi 7 · Bluetooth 6 · UWB · Thread · Matter' },
  { label: 'Charging',     value: 'Magnetic wireless on Pen · USB-C puck on Stand' },
  { label: 'Materials',    value: 'Machined aluminum · sapphire lens · optical-grade glass' },
  { label: 'Form',         value: '18 g · IP54 (Pen) · 14 × 4 cm (Stand)' },
];
---

<div class="specs frame">
  <div class="block col-2-3">
    <header class="reveal">
      <p class="eyebrow">Pen + Stand.</p>
      <h2>The numbers we're<br>aiming at.</h2>
      <p class="lede">
        We're not building hardware yet. These are the targets we'd aim at —
        what the technology of the next few years could make possible.
      </p>
    </header>

    <ul class="callouts reveal">
      {callouts.map(({ pen, stand, unit, caption }) => (
        <li>
          <span class="big">
            <span class="big-num" data-count={pen}>{pen}</span>
            <span class="big-sep" aria-hidden="true">/</span>
            <span class="big-num" data-count={stand}>{stand}</span>
          </span>
          <span class="unit">{unit}</span>
          <span class="caption">{caption}</span>
        </li>
      ))}
    </ul>

    <p class="legend reveal" aria-hidden="true">Pen / Stand</p>

    <ul class="fineprint reveal">
      {fineprint.map(({ label, value }) => (
        <li>
          <span class="fp-label">{label}</span>
          <span class="fp-value">{value}</span>
        </li>
      ))}
    </ul>

    <p class="philosophy reveal">
      Privacy-first. All sensitive inference happens on-device. End-to-end
      encrypted sync between Pen and Stand. No data leaves the device without
      explicit consent. Local-first by design.
    </p>
  </div>
</div>

<script is:inline>
  (() => {
    const counters = document.querySelectorAll('[data-count]');
    if (!counters.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const animate = (el) => {
      const target = parseInt(el.getAttribute('data-count') || '0', 10);
      if (Number.isNaN(target)) return;
      if (reduceMotion) {
        el.textContent = String(target);
        return;
      }
      el.textContent = '0';
      const duration = 1400;
      const start = performance.now();
      const tick = (now) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.floor(eased * target));
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = String(target);
      };
      requestAnimationFrame(tick);
    };

    if (!('IntersectionObserver' in window)) {
      counters.forEach(animate);
      return;
    }

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !entry.target.hasAttribute('data-counted')) {
            entry.target.setAttribute('data-counted', 'true');
            animate(entry.target);
          }
        });
      },
      { threshold: 0.55 }
    );
    counters.forEach((el) => obs.observe(el));
  })();
</script>

<style>
  .specs {
    font-family: var(--font-mono);
  }
  header {
    margin-bottom: clamp(56px, 9vh, 96px);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-meta);
    margin: 0 0 24px;
  }
  header h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.038em;
    line-height: 0.98;
    margin: 0 0 24px;
    color: var(--color-ink);
  }
  header .lede {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--color-ink-muted);
    margin: 0;
    max-width: 56ch;
  }

  .callouts {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(36px, 5vh, 56px) clamp(28px, 3.5vw, 56px);
    border-top: 1px solid var(--color-hairline);
    padding-top: clamp(36px, 5vh, 56px);
  }
  .callouts li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .big {
    display: flex;
    align-items: baseline;
    gap: clamp(6px, 0.8vw, 12px);
    font-family: var(--font-mono);
    font-size: clamp(30px, 4.2vw, 54px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .big-num {
    display: inline-block;
    text-align: right;
    min-width: 1.6ch;
  }
  .big-sep {
    color: var(--color-meta);
    font-weight: 400;
  }
  .unit {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-meta);
    margin-top: 6px;
  }
  .caption {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.4;
    color: var(--color-ink-muted);
    letter-spacing: 0;
    text-transform: none;
    margin-top: 10px;
    max-width: 22ch;
  }

  .legend {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-meta);
    margin: 0 0 clamp(40px, 6vh, 64px);
  }

  .fineprint {
    list-style: none;
    margin: 0 0 clamp(40px, 6vh, 64px);
    padding: 0;
    border-top: 1px solid var(--color-hairline);
  }
  .fineprint li {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: clamp(16px, 3vw, 32px);
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-hairline);
  }
  .fp-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-meta);
    white-space: nowrap;
  }
  .fp-value {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--color-ink-muted);
    text-align: right;
  }

  .philosophy {
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.1vw, 14px);
    line-height: 1.6;
    color: var(--color-meta);
    max-width: 70ch;
    margin: 0;
    padding-top: clamp(32px, 5vh, 48px);
    border-top: 1px solid var(--color-hairline);
    letter-spacing: 0;
  }

  @media (max-width: 720px) {
    .callouts { gap: 32px 16px; }
    .big { font-size: clamp(24px, 6.75vw, 33px); }
    .caption { max-width: none; }
    .fineprint li {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 12px 0;
    }
    .fp-value {
      text-align: left;
      font-size: 12px;
    }
  }

  [data-revealed="true"] header { transition-delay: 0ms; }
  [data-revealed="true"] .callouts { transition-delay: 200ms; }
  [data-revealed="true"] .legend { transition-delay: 360ms; }
  [data-revealed="true"] .fineprint { transition-delay: 480ms; }
  [data-revealed="true"] .philosophy { transition-delay: 620ms; }
</style>
