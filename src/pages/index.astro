---
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import Thesis from '../components/Thesis.astro';
import Carousel from '../components/Carousel.astro';
import System from '../components/System.astro';
import Beauty from '../components/Beauty.astro';
import Specs from '../components/Specs.astro';
import Status from '../components/Status.astro';
import SectionNav from '../components/SectionNav.astro';
import { sections } from '../lib/sections';

const labelOf = (id: string) => sections.find((s) => s.id === id)?.label ?? '';

const SPLINE_HERO_URL = 'https://my.spline.design/fountainclean-sBz7vvQkxCKWDeB5BG1KqRUQ/';
---

<Page>
  <SectionNav />

  <main>
    <section id="hero" data-section="hero" data-section-label={labelOf('hero')}>
      <Hero iframeUrl={SPLINE_HERO_URL} />
    </section>

    <section id="thesis" data-section="thesis" data-section-label={labelOf('thesis')}>
      <Thesis />
    </section>

    <section id="features" data-section="features" data-section-label={labelOf('features')}>
      <Carousel />
    </section>

    <section id="system" data-section="system" data-section-label={labelOf('system')}>
      <System />
    </section>

    <section id="beauty" data-section="beauty" data-section-label={labelOf('beauty')}>
      <Beauty />
    </section>

    <section id="specs" data-section="specs" data-section-label={labelOf('specs')}>
      <Specs />
    </section>

    <section id="status" data-section="status" data-section-label={labelOf('status')}>
      <Status />
    </section>
  </main>

  <script is:inline>
    (() => {
      const sections = document.querySelectorAll('[data-section]');
      if (!('IntersectionObserver' in window)) {
        sections.forEach((s) => s.setAttribute('data-revealed', 'true'));
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-revealed', 'true');
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );
      sections.forEach((s) => observer.observe(s));
    })();
  </script>
</Page>
